# community-service 개발 환경 변수 예시.
# 복사해서 쓴다:  cp .env.dev.example .env.dev
# .env.dev 는 .gitignore 대상이다. 이 파일에는 실제 값을 절대 넣지 않는다.
#
# 여기 있는 변수는 전부 Spring 앱이 읽는다. Docker/Compose 전용 변수는 없다
# (이 레포에는 compose 파일이 없고, docker run --env-file 로 그대로 넘긴다).

# ── 프로파일 ────────────────────────────────────────────────
# dev/prod 를 고른다. app.security.jwt.secret 이 프로파일 파일에만 있어서 반드시 지정해야 한다.
SPRING_PROFILES_ACTIVE=dev

# ── 포트 ────────────────────────────────────────────────────
# 애플리케이션 HTTP 포트.
SERVER_PORT=8080
# actuator 전용 관리 포트. 앱 포트와 분리해 외부 노출을 막는다.
MANAGEMENT_SERVER_PORT=9091

# ── 데이터베이스 ────────────────────────────────────────────
# JDBC URL. community 스키마를 쓰므로 currentSchema 를 붙인다.
# 컨테이너에서 호스트 DB 에 붙을 때는 localhost 대신 host.docker.internal 을 쓴다.
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/travel_diary_dev?currentSchema=community
# DB 접속 계정.
SPRING_DATASOURCE_USERNAME=travel_diary_dev
# DB 접속 비밀번호.
SPRING_DATASOURCE_PASSWORD=changeme

# ── 서비스 간 연동 ──────────────────────────────────────────
# Identity 서비스 base URL. 사용자 조회에 쓴다.
IDENTITY_BASE_URL=http://localhost:8081
# Travel 서비스 base URL. 여행 기록 접근 권한 확인에 쓴다.
TRAVEL_BASE_URL=http://localhost:8083

# ── 보안 ────────────────────────────────────────────────────
# CORS 허용 origin. 콤마로 여러 개.
CORS_ALLOWED_ORIGINS=http://localhost:3000
# JWT issuer. Identity 가 발급할 때 넣는 값과 같아야 검증을 통과한다.
JWT_ISSUER=identity-service
# access token 유효기간.
JWT_ACCESS_TOKEN_TTL=30m
# JWT 서명 키(HS256). 32바이트 이상이어야 기동한다. 네 서비스가 같은 값을 쓴다.
JWT_SECRET=change-me-to-a-random-secret-of-at-least-32-bytes

# ── 로깅 ────────────────────────────────────────────────────
# 로그 파일 경로. 호스트에서 bootRun 할 때는 아래 상대경로면 되고,
# 컨테이너로 띄울 때는 /var/log/travel-planner/travel-planner.log 로 바꾼다
# (Dockerfile 이 spring 유저 권한으로 만들어 둔 경로).
LOGGING_FILE_NAME=logs/travel-planner.log

# ── 빌드 전용 (이 파일에 넣지 않는다) ───────────────────────
# travel-common 의존성을 GitHub Packages 에서 받으려면 아래 두 값이 필요하다.
# 다만 런타임 변수가 아니라 Gradle 빌드 변수라, 컨테이너에 주입하면 토큰만 새어 나간다.
# 셸 환경변수나 ~/.gradle/gradle.properties(gpr.user / gpr.key)로 준다. CI 는 GitHub Secrets 를 쓴다.
#   GITHUB_PACKAGES_USER    GitHub 사용자명
#   GITHUB_PACKAGES_TOKEN   read:packages 권한 PAT
