# community-service 운영 환경 변수 예시.
# 복사해서 쓴다:  cp .env.prod.example .env.prod
# .env.prod 는 .gitignore 대상이다. 이 파일에는 실제 값을 절대 넣지 않는다.
#
# dev 와 다른 값만 짚으면: SPRING_PROFILES_ACTIVE, JWT_SECRET(기본값 없음),
# LOGGING_FILE_NAME(절대경로), 서비스 base URL(클러스터 DNS). 나머지는 dev 와 같다.

# ── 프로파일 ────────────────────────────────────────────────
# prod 프로파일은 JWT_SECRET 에 기본값이 없어, 값을 안 주면 기동 자체가 실패한다.
SPRING_PROFILES_ACTIVE=prod

# ── 포트 ────────────────────────────────────────────────────
# 애플리케이션 HTTP 포트.
SERVER_PORT=8080
# actuator 전용 관리 포트. 앱 포트와 분리해 외부 노출을 막는다.
MANAGEMENT_SERVER_PORT=9091

# ── 데이터베이스 ────────────────────────────────────────────
# JDBC URL. community 스키마를 쓰므로 currentSchema 를 붙인다.
SPRING_DATASOURCE_URL=jdbc:postgresql://postgres:5432/travel_diary?currentSchema=community
# DB 접속 계정.
SPRING_DATASOURCE_USERNAME=travel_diary
# DB 접속 비밀번호.
SPRING_DATASOURCE_PASSWORD=replace-with-the-real-password

# ── 서비스 간 연동 ──────────────────────────────────────────
# Identity 서비스 base URL. 클러스터 내부 Service DNS.
IDENTITY_BASE_URL=http://identity:8080
# Travel 서비스 base URL. 클러스터 내부 Service DNS.
TRAVEL_BASE_URL=http://travel:8080

# ── 보안 ────────────────────────────────────────────────────
# CORS 허용 origin. 콤마로 여러 개. 운영 도메인으로 바꾼다.
CORS_ALLOWED_ORIGINS=https://replace-with-the-service-domain
# JWT issuer. Identity 가 발급할 때 넣는 값과 같아야 검증을 통과한다.
JWT_ISSUER=identity-service
# access token 유효기간.
JWT_ACCESS_TOKEN_TTL=30m
# JWT 서명 키(HS256). 32바이트 이상. 운영에서는 Secret 으로 주입하고 여기 적지 않는다.
JWT_SECRET=replace-with-a-random-secret-of-at-least-32-bytes

# ── 로깅 ────────────────────────────────────────────────────
# 로그 파일 경로. Dockerfile 이 spring 유저 권한으로 만들어 둔 절대경로.
LOGGING_FILE_NAME=/var/log/travel-planner/travel-planner.log

# ── 빌드 전용 (이 파일에 넣지 않는다) ───────────────────────
# GITHUB_PACKAGES_USER / GITHUB_PACKAGES_TOKEN 은 Gradle 빌드 변수다.
# 런타임에 필요 없으므로 컨테이너에 주입하지 않는다. 자세한 건 .env.dev.example 참고.
